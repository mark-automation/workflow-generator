{
  "x-wfgen": {
    "name": "rss-to-channel",
    "description": "Polls an RSS feed on a schedule and posts new items to a Discord channel via webhook.",
    "params": {
      "schedule_cron": {"type": "string", "required": true, "description": "5-field cron for poll frequency"},
      "rss_url": {"type": "string", "required": true, "description": "RSS/Atom feed URL"},
      "discord_webhook_url": {"type": "string", "required": true, "description": "Discord channel webhook URL"}
    }
  },
  "name": "wfgen: rss-to-channel",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "cronExpression", "expression": "$param:schedule_cron" }] }
      },
      "id": "22222222-0001-4000-8000-000000000001",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-200, 0]
    },
    {
      "parameters": {
        "url": "$param:rss_url",
        "options": {}
      },
      "id": "22222222-0002-4000-8000-000000000002",
      "name": "Fetch RSS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [0, 0],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Parse feed, take 5 newest items\nconst xml = $input.first().json.data || '';\nconst items = [...xml.matchAll(/<item[\\s\\S]*?<\\/item>/g)].slice(0, 5).map(m => m[0]);\nconst out = items.map(it => {\n  const t = (it.match(/<title>(?:<!\\[CDATA\\[)?([\\s\\S]*?)(?:\\]\\]>)?<\\/title>/) || [])[1] || 'untitled';\n  const l = (it.match(/<link>(?:<!\\[CDATA\\[)?([\\s\\S]*?)(?:\\]\\]>)?<\\/link>/) || [])[1] || '';\n  return { json: { content: `📰 **${t.trim()}**\\n${l.trim()}` } };\n});\nreturn out.length ? out : [{ json: { content: null, skip: true } }];"
      },
      "id": "22222222-0003-4000-8000-000000000003",
      "name": "Parse Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            { "id": "c1", "leftValue": "={{ $json.skip }}", "rightValue": true, "operator": { "type": "boolean", "operation": "false", "singleValue": true } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "22222222-0004-4000-8000-000000000004",
      "name": "Has Item?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "$param:discord_webhook_url",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: $json.content }) }}",
        "options": {}
      },
      "id": "22222222-0005-4000-8000-000000000005",
      "name": "Post to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, -60],
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Schedule": { "main": [[{ "node": "Fetch RSS", "type": "main", "index": 0 }]] },
    "Fetch RSS": { "main": [[{ "node": "Parse Items", "type": "main", "index": 0 }]] },
    "Parse Items": { "main": [[{ "node": "Has Item?", "type": "main", "index": 0 }]] },
    "Has Item?": { "main": [[{ "node": "Post to Discord", "type": "main", "index": 0 }], []] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
